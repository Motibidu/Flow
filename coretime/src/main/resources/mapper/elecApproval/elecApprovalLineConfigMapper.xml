<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.flow.coretime.elecApproval.mapper.ElecApprovalLineConfigMapper">
        <select id="getApprovalConfigList" resultType="com.flow.coretime.elecApproval.model.ElecApprovalLineConfigEntity">
                SELECT 
                        config_id,
                        doc_type,
                        position,
                        department,
                        approval_order,
                        description
                FROM 
                        approval_line_config
                WHERE 
                        doc_type = #{docType}

                ORDER BY 
                        approval_order ASC
        </select>

        <select id="getApprovalLineConfigRespDto" resultType="com.flow.coretime.elecApproval.model.ApprovalLineConfigRespDto">
                SELECT 
                        u.id AS userId,
                        u.name AS userName,
                        u.position AS position,
                        u.department AS department
                FROM 
                        approval_line_config config
                        JOIN users u ON 
                                ( config.DEPARTMENT= 'DRAFTER'
                                  AND u.department = #{department}
                                  AND u.position = config.POSITION
                                )
                                OR
                                (
                                        config.DEPARTMENT = 'MANAGEMENT'
                                        AND u.position = config.POSITION 
                                )
                WHERE 
                        doc_type = #{docType}
                        AND u.id != #{userId}
                ORDER BY 
                        approval_order ASC
        </select>
</mapper>